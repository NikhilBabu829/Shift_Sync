# --- Existing variables (already in your .env) ---
MONGODB_URI=
JWT_SECRET=
JWT_INVITE_SECRET=
ROOT_SECRET_PASS=
PASSPORT_SECRET=
GMAIL=
GMAIL_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- NEW: Add these to your .env ---

# Local LLM via Ollama (Feature 1 — NLP Shift Manager)
# Install: https://ollama.com  |  then run: ollama pull gemma3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# Python ML microservice (Features 2 & 4 — Smart Match + GPS Anomaly)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=3000

# GPS velocity threshold in mph — punches above this speed are flagged
DRIVE_BY_THRESHOLD_MPH=10

# CORS — set to your frontend's origin in production
CORS_ORIGIN=http://localhost:5173
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
